DJANGO_SECRET_KEY=generate-a-secure-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-production-domain.com
DJANGO_LOG_LEVEL=INFO

DB_NAME=hydro
DB_USER=postgres
DB_PASSWORD=your-secure-db-password
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=require

CORS_ALLOWED_ORIGINS=https://your-app-domain.com
SECURE_SSL_REDIRECT=True

FIREBASE_PROJECT_ID=agromonitoringapp
# Local Django: set this to your service-account JSON path.
# Docker Compose: set FIREBASE_CREDENTIALS_HOST_PATH to its host path.
FIREBASE_CREDENTIALS=
FIREBASE_CREDENTIALS_HOST_PATH=
